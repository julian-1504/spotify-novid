# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local config. The client ID is a public identifier rather than a secret
# (PKCE, no client secret), but it points at one specific dashboard app, so it
# stays out of the repo — .env.example is the committed template.
.env
.env.*
!.env.example

# Android wrapper build output. The wrapper scripts themselves — android/gradlew
# and android/gradle/ — are committed on purpose: they are how the build pins
# its own Gradle version on a machine that has none.
android/.gradle/
android/build/
android/app/build/
android/local.properties

# Release signing. Neither the keystore nor its passwords belong in the repo,
# and losing them is not recoverable: an APK signed with a different key
# installs as a different app rather than as an update.
android/keystore.properties
*.jks
*.keystore

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
