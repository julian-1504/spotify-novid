<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Everything below exists for one reason: when this phone *is* the box, the
        music has to survive the screen going off.

        The Web Playback SDK runs inside the WebView, so Spotify's next track is
        fetched and decoded by this app's own processes. Without a foreground
        service the app is a cached process the moment the Activity stops —
        frozen, network-deferred, killable — and playback died at the first track
        boundary. FOREGROUND_SERVICE_MEDIA_PLAYBACK is the Android 14 half of the
        same declaration; WAKE_LOCK keeps the CPU (and the wifi radio) up across
        that boundary; POST_NOTIFICATIONS only decides whether the controls are
        *visible*, never whether the music plays.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <!--
            allowBackup is off because the WebView's storage holds Spotify
            refresh tokens for every account on the phone, and cloud backup
            would carry them off the device.

            configChanges keeps the Activity — and with it the WebView and
            whatever is playing — alive across the configuration changes that
            still happen on a portrait-locked phone: dark mode, font size, a
            keyboard appearing.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|layoutDirection|locale|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Not exported: nothing outside this app has any business starting it,
            and the only thing that ever does is the page in the WebView saying
            that music is playing.
        -->
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
